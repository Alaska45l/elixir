# App
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Database
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin session
SESSION_SECRET=change-this-to-a-random-64-char-string
SESSION_DURATION_HOURS=8
SESSION_SAME_SITE=strict

# MercadoPago
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_WEBHOOK_SECRET=your-webhook-secret

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Email (SMTP - optional, stub if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contacto@elixirexclusive.com.ar

# WhatsApp
WHATSAPP_NUMBER=5491100000000

# Shipping carriers
CORREO_ARG_API_KEY=
CORREO_ARG_CLIENT_ID=
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CLIENT_ID=
ORIGIN_POSTAL_CODE=1000

# Cloudflare R2 image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Logging
LOG_LEVEL=info
